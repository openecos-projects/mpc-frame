{
  "tests": [
    {
      "name": "boot",
      "image": "sw/bootrom/hello/retrosoc_fw.bin",
      "max_cycles": 500000,
      "uart_stop_text": "done!"
    },
    {
      "name": "uart",
      "image": "sw/bootrom/uart_poll/uart_poll.bin",
      "max_cycles": 1000000,
      "uart_input": "Z",
      "uart_start_cycle": 300000,
      "uart_stop_text": "uart poll ok",
      "uart_fail_text": "uart poll fail"
    },
    {
      "name": "gpio",
      "build": {
        "app": "gpio",
        "drivers": ["sys_uart", "gpio"],
        "link_target": "xip"
      },
      "image": "build/sw/mpc-soc/gpio/gpio.bin",
      "max_cycles": 1000000,
      "uart_stop_text": "gpio ok",
      "uart_fail_text": "gpio fail",
      "gpio_in": "0x0000000400000004",
      "gpio_drive": "0x0000000c0000000c",
      "gpio_expect": "1,2,3,0,0x100000000,0x200000000,0x300000000,0",
      "gpio_expect_mask": "0x300000003"
    },
    {
      "name": "psram",
      "build": {
        "app": "psram",
        "drivers": ["sys_uart"],
        "link_target": "xip"
      },
      "image": "build/sw/mpc-soc/psram/psram.bin",
      "max_cycles": 1000000,
      "uart_stop_text": "psram ok",
      "uart_fail_text": "psram fail"
    }
  ]
}
