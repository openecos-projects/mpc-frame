# Repository whitelist: ignore every root entry unless explicitly admitted.
/*

!/.gitignore
!/.github/
!/LICENSE
!/Makefile
!/README.md
!/README.en.md
!/FrameTop.sv
!/docs/
!/designs/
!/reference/
!/rtl/
!/scripts/
!/tests/
!/spec/

# QA notes are local discussion records and are not repository deliverables.
/docs/*-qa.md
/docs/qa/

# Generated artifacts inside admitted source trees.
**/__pycache__/
**/*.pyc
**/*.o
**/*.log
**/*.vcd
**/*.fst
**/*.fsdb
**/obj_dir/
