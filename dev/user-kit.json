{
  "files": [
    "FrameTop.sv",
    "Makefile",
    "designs/registry.json",
    "mk/common.mk",
    "mk/user.mk",
    "scripts/design_registry.py"
  ],
  "trees": [
    "rtl",
    "designs/template"
  ],
  "public_docs": {
    "manifest": "dev/site-docs.json",
    "exclude": [
      "index.md"
    ]
  },
  "generated": {
    "registry": "designs/registry.json",
    "rtl": "rtl/generated/FrameDesignRegistry.sv",
    "filelist": "rtl/generated/user-designs.f",
    "metadata": "FRAME_VERSION"
  },
  "overrides": [
    {
      "source": "dev/user-kit/README.md",
      "destination": "README.md"
    },
    {
      "source": "dev/user-kit/README.en.md",
      "destination": "README.en.md"
    },
    {
      "source": "dev/user-kit/.gitignore",
      "destination": ".gitignore"
    }
  ]
}
